{
  // Copy this file to wrangler.personal.jsonc and fill in your private
  // deployment values. The real file is ignored by Git.
  // Design: loro-sessions §2 (topology), §3 (persistence), §6.1 (diff
  // sidecar), §8 (device-room streams), §1.2 (R2 attachments), §3.3 (R2
  // backups); ARCHITECTURE.md §6.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_PRIVATE_WORKER_NAME",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "account_id": "REPLACE_WITH_PRIVATE_CLOUDFLARE_ACCOUNT_ID",
  "workers_dev": true,
  // Serve src/install.sh as a string (the /install.sh route).
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  // loro-crdt's default entry loads its WASM via URL fetch, which workerd
  // cannot do at runtime; the base64 entry inlines the module instead.
  "alias": {
    "loro-crdt": "loro-crdt/base64"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_ROOMS", "class_name": "SessionRoom" },
      { "name": "DEVICE_ROOMS", "class_name": "DeviceRoom" },
      { "name": "REGISTRY_ROOMS", "class_name": "RegistryRoom" },
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" },
      { "name": "STUDIO_ROOMS", "class_name": "StudioRoom" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SessionRoom", "DeviceRoom"]
    },
    {
      // Workspace registry (docs/registry-sync.md) — the row-table sidebar
      // sync that replaces the Loro workspace doc rooms.
      "tag": "v2",
      "new_sqlite_classes": ["RegistryRoom"]
    },
    {
      // chat2 session rooms (docs/chat2-sync.md) — dumb log relays that
      // replace SessionRoom's loro-aware s2 rooms.
      "tag": "v3",
      "new_sqlite_classes": ["ChatRoom"]
    },
    {
      // Personal Studio manifest CAS coordinator. Media and SQLite snapshots
      // remain content-addressed objects in R2, never SQLite values here.
      "tag": "v4",
      "new_sqlite_classes": ["StudioRoom"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOBS",
      "bucket_name": "REPLACE_WITH_PRIVATE_BLOBS_BUCKET"
    },
    {
      "binding": "RELEASES",
      "bucket_name": "REPLACE_WITH_PRIVATE_RELEASES_BUCKET"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "WORKOS_CLIENT_ID",
      "store_id": "REPLACE_WITH_PRIVATE_SECRETS_STORE_ID",
      "secret_name": "WORKOS_CLIENT_ID"
    },
    {
      "binding": "WORKOS_API_KEY",
      "store_id": "REPLACE_WITH_PRIVATE_SECRETS_STORE_ID",
      "secret_name": "WORKOS_API_KEY"
    }
  ],
  "vars": {
    "AUTH_MODE": "workos"
  },
  "observability": {
    "enabled": true
  }
}
